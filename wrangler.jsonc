{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaireen-e-karbala",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zaireen-e-karbala",
      "database_id": "e1924576-48f3-4c24-954a-46be04e5c50b",
      "migrations_dir": "migrations"
    }
  ],
  // Secrets (set with `wrangler secret put`, never in this file):
  //   ADMIN_PIN, SESSION_KEY, NKERP_LOGIN_ID, NKERP_PASSWORD, MAWAID_LOOKUP_TOKEN, VAPID_PRIVATE_KEY
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
